# Bold Reports Multi-Tenancy - Production Environment Variables
# Copy this file to .env on your production server and fill in with actual values

# ============================================================================
# Bold Reports API Configuration
# ============================================================================

# Bold Reports Server URL (with site ID)
REPORT_SERVER_URL=https://cloud.boldreports.com/reporting/api/site/YOUR_SITE_ID

# Bold Reports Report Service URL
REPORT_SERVICE_URL=https://cloud.boldreports.com/reporting/reportservice/api/Viewer

# Bold Reports Token Endpoint
TOKEN_URL=https://cloud.boldreports.com/reporting/api/site/YOUR_SITE_ID/token

# Report Path ID
REPORT_PATH=YOUR_REPORT_ID

# Bold Reports Site Name
SITE_NAME=YOUR_SITE_NAME

# ============================================================================
# Bold Reports Credentials (KEEP SECURE!)
# ============================================================================

# Bold Reports Username
REPORT_USER=your-email@example.com

# Bold Reports Password (Keep Secure!)
REPORT_PASSWORD=your-secure-password

# Bold Reports Embed Secret (Keep Secure!)
EMBED_SECRET=your-embed-secret-key

# ============================================================================
# Server Configuration
# ============================================================================

# Server Port
PORT=3001

# Node Environment
NODE_ENV=production

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 
# 1. NEVER commit this file to git (it's listed in .gitignore)
# 2. Keep this file secure with permissions: chmod 600 .env
# 3. Only accessible by application user (e.g., www-data)
# 4. Store backups in secure location
# 5. Use strong passwords for all credentials
# 6. Rotate credentials regularly
# 7. Monitor access logs for unauthorized attempts
#
# ============================================================================
