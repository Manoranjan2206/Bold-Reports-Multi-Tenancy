[Unit]
Description=Bold Reports Multi-Tenancy Application
After=network.target

Documentation=file:///var/www/bold-reports/DEPLOYMENT.md
Documentation=https://support.boldreports.com/

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/bold-reports

# Load environment variables from .env file
EnvironmentFile=/var/www/bold-reports/.env

# Start the application
ExecStart=/usr/bin/node server/server.js

# Automatically restart if crashes
Restart=always
RestartSec=10

# Process management
KillMode=process
KillSignal=SIGTERM

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bold-reports

# Resource limits (optional)
# LimitNOFILE=65536
# LimitNPROC=512

# Security settings (optional)
# PrivateTmp=true
# ProtectSystem=strict
# ProtectHome=true
# NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
